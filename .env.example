# Copy to .env for local use. Never commit real values.
APP_ENV=development
SECRET_KEY=
DATABASE_URL=sqlite:///./data/handover.db
DEMO_MODE=false
JOB_MODE=thread
COOKIE_SECURE=false
MIGRATE_ON_STARTUP=true
